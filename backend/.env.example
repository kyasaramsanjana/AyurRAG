# AyurRAG Environment Configuration
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ayurrag
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=ayurrag_local.db

# Embedding Configuration (BAAI/bge-base-en-v1.5, 768 dimensions per Slide 10)
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# LLM Synthesis Configuration (Slide 4, 21, 23)
# Optional: Provide Google Gemini API Key for online synthesis, or leave blank to use intelligent offline classical fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
